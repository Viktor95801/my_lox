expression  ::= equality ; (* comma ;
comma ::= equality ( "," equality )* ; *)
equality    ::= comparison ( ( "!=" | "==" ) comparison )* ;
comparison  ::= term ( ( ">" | ">=" | "<" | "<=" ) term )* ;
term        ::= factor ( ( "-" | "+" ) factor )* ;
factor      ::= unary ( ( "/" | "*" ) unary )* ;
unary       ::= ( "!" | "-" ) unary
               | primary ;
primary     ::= NUMBER | STRING | "true" | "false" | "nil"
               | "(" expression ")" ;
               
NUMBER      ::= [0-9]+(\.[0-9]+)? ;
STRING      ::= '"' [^"\n]* '"' ;
