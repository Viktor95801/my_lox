var a = 0;
var temp;
var clock_start = clock();
var i = 0;
for (var b = 1; i < 30; b = temp + b) {
  print a;
  temp = a;
  a = b;
  i = i + 1;
}
var end =clock()-clock_start;
print end;
del end;
del clock_start;
del a;
del temp;
del i;

print "Variables deleted";